# Local development only; SQLite is not supported on ephemeral Vercel filesystems.
NEXA_DB_PATH=.data/nexa.sqlite
# Set to the actual deployment origin. Cross-origin mutations are rejected.
APP_URL=http://localhost:3000
# Optional: enables real grounded AI requests. Otherwise approved FAQ lookup + handoff.
NEXA_AI_API_KEY=
NEXA_AI_MODEL=gpt-4.1-mini
# Public widgets require business owners to configure allowed host origins.
# Never put secrets in NEXT_PUBLIC_ variables. No production credentials are seeded.

# Persistently rate-limited per organization; successful requests record actual token usage.
NEXA_AI_DAILY_CAP=100
